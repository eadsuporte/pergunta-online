{{>partials/site_header}}
<article class="detail-card">
    <div class="card-top">
        <div class="club"><span class="badge">{{focus_abbr}}</span>{{focus_name}}</div>
        <span class="status {{status_class}}">{{status_label}}</span>
    </div>
    <div class="category">{{category}}</div>
    <h1>{{title}}</h1>
    <p class="lead">{{{body_html}}}</p>
    <div class="meta">Pergunta de <strong>{{author_name}}</strong> para <strong>{{target_name}}</strong> · {{created_at}}</div>

    {{#is_duplicate}}
    <div class="flash warning question-duplicate">
        Esta pergunta foi marcada como duplicada. A discussão principal está em
        <a href="{{duplicate_url}}"><strong>{{duplicate_title}}</strong></a>.
    </div>
    {{/is_duplicate}}

    {{#has_taken_by}}<div class="question-taken-by">Pauta assumida por <strong>{{taken_by_name}}</strong>{{#taken_at}} em {{taken_at}}{{/taken_at}}</div>{{/has_taken_by}}

    <div class="detail-stats">
        <strong>{{vote_count}}</strong><span>endossos “Boa!”</span>
        {{#show_silence}}<strong>{{silence_days}}</strong><span>dias de silêncio registrados</span>{{/show_silence}}
    </div>

    {{#can_respond}}
    <div class="question-response-action">
        <a class="button primary" href="{{respond_url}}">Assumir pauta / registrar resposta</a>
    </div>
    {{/can_respond}}

    {{#has_answer}}
    <section class="answer">
        <div class="eyebrow">RESPOSTA REGISTRADA</div>
        <p>{{{answer_html}}}</p>
        {{#answered_by_name}}<small>Respondida por <strong>{{answered_by_name}}</strong></small>{{/answered_by_name}}
        {{#answered_at}}<small>Registrada em {{answered_at}}</small>{{/answered_at}}
    </section>
    {{/has_answer}}

    {{#has_evidence}}
    <section class="question-evidence">
        <div class="eyebrow">EVIDÊNCIAS</div>
        <div class="admin-simple-list">
        {{#evidence}}
            <div>
                <strong>{{title}}</strong>
                <small>{{type}} · {{created_at}}</small>
                {{#is_url}}<a href="{{reference}}" rel="nofollow noopener" target="_blank">{{reference}}</a>{{/is_url}}
                {{#is_text}}<p>{{reference}}</p>{{/is_text}}
                {{#has_file}}<a href="{{download_url}}">Baixar {{original_name}}</a>{{/has_file}}
            </div>
        {{/evidence}}
        </div>
    </section>
    {{/has_evidence}}

    {{#has_history}}
    <section class="question-history">
        <div class="eyebrow">HISTÓRICO</div>
        <div class="admin-timeline">
        {{#history}}
            <div class="admin-timeline-item">
                <strong>{{label}}</strong>
                <span>{{status_change}}</span>
                <p>{{details}}</p>
                <small>{{actor}} · {{created_at}}</small>
            </div>
        {{/history}}
        </div>
    </section>
    {{/has_history}}

    <section class="question-comments" id="comments">
        <div class="question-comments-head">
            <div>
                <div class="eyebrow">CONVERSA DA COMUNIDADE</div>
                <h2>Comentários <span>({{comment_count}})</span></h2>
            </div>
            <small>Comentários não são respostas oficiais.</small>
        </div>

        {{#has_comments}}
        <div class="question-comments-list">
            {{#comments}}
            <article class="question-comment">
                <div class="question-comment-top">
                    <div><strong>{{author}}</strong>{{#is_guest}} <span class="comment-guest-label">Visitante</span>{{/is_guest}}</div>
                    <time>{{created_at}}</time>
                </div>
                <p>{{body}}</p>
                {{#can_delete}}
                <form method="post" action="{{comment_action_url}}" class="comment-delete-form">
                    <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                    <input type="hidden" name="action" value="delete_comment">
                    <input type="hidden" name="comment_id" value="{{id}}">
                    <button type="submit" class="button ghost small">Remover comentário</button>
                </form>
                {{/can_delete}}
            </article>
            {{/comments}}
        </div>
        {{/has_comments}}
        {{^has_comments}}
        <p class="muted">Ainda não há comentários. Inicie a conversa.</p>
        {{/has_comments}}
        {{#comments_open}}
        <form method="post" action="{{comment_action_url}}" class="admin-stack-form question-comment-form">
            <h3>Deixe seu comentário</h3>
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="action" value="add_comment">
            {{#comment_guest}}
            <label><span>Seu nome</span><input name="guest_name" maxlength="120" autocomplete="name" required></label>
            {{/comment_guest}}
            {{#comment_logged_in}}
            <p class="muted">Comentando como <strong>{{comment_current_name}}</strong>.</p>
            {{/comment_logged_in}}
            <label><span>Comentário</span><textarea name="body" rows="4" maxlength="2000" minlength="2" required></textarea></label>
            <div class="comment-honeypot" aria-hidden="true">
                <label>Website <input name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <button class="button primary" type="submit">Publicar comentário</button>
        </form>
        {{/comments_open}}
    </section>

    {{#can_report}}
    <details class="question-report">
        <summary>Denunciar esta pergunta</summary>
        <form method="post" action="{{report_url}}" class="admin-stack-form">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="question_id" value="{{id}}">
            <label><span>Motivo</span>
                <select name="reason" required>
                    <option value="spam">Spam</option>
                    <option value="offensive">Conteúdo ofensivo</option>
                    <option value="illegal">Conteúdo ilegal</option>
                    <option value="duplicate">Pergunta duplicada</option>
                    <option value="other">Outro</option>
                </select>
            </label>
            <label><span>Detalhes</span><textarea name="details" rows="3"></textarea></label>
            <button class="button ghost small" type="submit">Enviar denúncia</button>
        </form>
    </details>
    {{/can_report}}
</article>
{{>partials/site_footer}}
