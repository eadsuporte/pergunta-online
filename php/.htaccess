Options -Indexes -MultiViews

<FilesMatch "^(config\.php|schema\.sql|README\.md|\.env|\.env\..*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Expose the MCP endpoint and all three well-known OAuth metadata
    # lookup forms used by ChatGPT. A single escaped dot matches ".well-known".
    RewriteRule ^mcp/?$ admin/api-chatgpt/mcp.php [END,QSA]
    RewriteRule ^oauth/(authorize|token|register)/?$ admin/api-chatgpt/oauth.php?action=$1 [END,QSA]
    RewriteRule ^\.well-known/oauth-protected-resource(?:/mcp)?/?$ admin/api-chatgpt/oauth.php?action=resource [END,QSA]
    RewriteRule ^mcp/\.well-known/oauth-protected-resource/?$ admin/api-chatgpt/oauth.php?action=resource [END,QSA]
    RewriteRule ^\.well-known/oauth-authorization-server(?:/mcp)?/?$ admin/api-chatgpt/oauth.php?action=metadata [END,QSA]
    RewriteRule ^mcp/\.well-known/oauth-authorization-server/?$ admin/api-chatgpt/oauth.php?action=metadata [END,QSA]

    # Canonical public URLs never expose index.php or the .php extension.
    # Use absolute URL-path substitutions here. Relative substitutions in
    # per-directory context can leak the physical filesystem path into Location.
    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ / [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+(.+/)index\.php(?:[?\s]) [NC]
    RewriteRule ^(.+)/index\.php$ /$1/ [R=301,L,NE]

    # ChatGPT API endpoints keep their physical .php filenames. The child
    # .htaccess disables rewriting inside that directory, but this exclusion is
    # also required here because parent per-directory rules run first.
    RewriteCond %{REQUEST_URI} !/admin/api-chatgpt/ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

    # Resolve extensionless routes to the existing PHP files internally.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
